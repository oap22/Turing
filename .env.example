TURING_NODE_NAME=pi-alpha
TURING_NODE_ID=
# Surface-agnostic admin allow-list (ADR 0010 retired the Discord task bot).
# Operator user IDs the safety gate auto-approves for HIGH-risk tool calls.
TURING_ADMIN_USER_IDS=[]

# ── Closed-laptop alert fallback: ntfy ───────────────────────────────
# ntfy push for hardware-safety alerts when the SPA is unreachable (the
# closed-laptop fallback per ADR-0010 §2; replaces the retired Discord DM).
# The dispatcher POSTs the alert text to {base_url}/{topic}. Set BOTH on the
# Surface coordinator ONLY — workers never post alerts. Leave either unset
# (keep commented) to disable the ntfy fallback.
# TURING_OPERATOR_NTFY_TOPIC=turing-alerts-<operator>
# TURING_COORDINATOR_NTFY_BASE_URL=http://surface.<tailnet>.ts.net:8090

# ── Runtime bus (NATS) — REQUIRED on workers ─────────────────────────
# The worker dials the coordinator's NATS bus and authenticates with its
# own nkey seed (ADR-0010 §9). Both fields are REQUIRED on every Jetson
# worker — the systemd unit refuses to start if either is empty.
# Paste BOTH from the coordinator's setup-coordinator.sh Phase 5 output
# (Slice G2): the coordinator generates one seed per worker and prints it
# alongside its own NATS URL. Seeds are never transmitted automatically.
# URL is shown in its Tailnet form; the config default is nats://127.0.0.1:4222
# for local dev. The seed has no default — leave blank to fail closed.
TURING_NATS_URL=nats://surface.<tailnet>.ts.net:4222
TURING_NATS_NKEY_SEED=
TURING_ANTHROPIC_API_KEY=
TURING_ANTHROPIC_MODEL=claude-sonnet-4-20250514
TURING_OLLAMA_HOST=http://localhost:11434
TURING_OLLAMA_MODEL=gemma3:1b
# Keep the model resident between turns ('30m', '1h', '-1' = forever). Ollama's
# own default unloads after 5 idle minutes and a reload costs seconds on a
# Pi/Jetson; the model is also pre-loaded at startup (TURING_OLLAMA_WARMUP).
TURING_OLLAMA_KEEP_ALIVE=30m
TURING_OLLAMA_WARMUP=true
# TURING_OLLAMA_NUM_CTX=8192
# ── Peer model routing (fleet) ────────────────────────────────────────
# URL other nodes should use to reach THIS node's Ollama. Advertised in
# presence heartbeats so a node that has not pulled TURING_OLLAMA_MODEL can
# borrow one that has (turing.llm.pool). Leave unset on a node that should
# never serve peers. Requires Ollama listening on the LAN:
#   scripts/fleet-models.sh expose <host>
# TURING_OLLAMA_ADVERTISE_HOST=http://jetson-1:11434
TURING_LLM_PEER_MODELS_ENABLED=true
# Local tool calls are model-dependent; enable only for a model you have
# verified can return and continue from Ollama tool calls.
TURING_OLLAMA_TOOLS_ENABLED=false
TURING_LLM_ROUTING_MODE=auto
# Single-operator nodes: approve HIGH-risk tool calls without an admin id
# (the interactive confirmation surface was retired with ADR 0010, so
# NEEDS_CONFIRMATION is otherwise a hard deny). Deny-list still applies.
TURING_SAFETY_AUTO_APPROVE_HIGH_RISK=false
TURING_DB_PATH=./data/turing.db
TURING_EMBEDDING_MODEL_PATH=./models/all-MiniLM-L6-v2

# ── Native agent mailbox (optional, all three required together) ───────
# Dedicated SQLite store shared by cooperating local coding agents. Keep the
# database outside worktrees and use one unique workflow per task group.
# TURING_AGENT_MAILBOX_DB=/var/lib/turing/mailbox.db
# TURING_AGENT_MAILBOX_WORKFLOW=task-436
# TURING_AGENT_MAILBOX_AGENT=pi-alpha
# Vault git repo working tree on the coordinator (WSL2 ext4). The watcher
# diffs each new commit against its parent and reindexes only changed files.
TURING_VAULT_ROOT=/home/turing/vault
TURING_VAULT_POLL_INTERVAL_SECONDS=5.0
TURING_MESH_ENABLED=false
TURING_MESH_PORT=5670
# ── Mesh presence signing (issue #348) — REQUIRED when mesh is enabled ─
# Presence heartbeat/leave messages are Ed25519-signed MeshMessage envelopes
# on SignedTransport. BOTH fields below must be set for presence to start;
# fail-closed: leave either unset and the node runs as a singleton (no
# unsigned presence traffic is ever published or consumed).
# Seed: this node's PRIVATE key seed as 64 hex chars (32 bytes). Generate:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import \
#     Ed25519PrivateKey as K; from cryptography.hazmat.primitives.serialization \
#     import Encoding, PrivateFormat, PublicFormat, NoEncryption; k=K.generate(); \
#     print('seed', k.private_bytes(Encoding.Raw, PrivateFormat.Raw, \
#     NoEncryption()).hex()); print('pub ', k.public_key().public_bytes(\
#     Encoding.Raw, PublicFormat.Raw).hex())"
# Keep the seed secret; never reuse one seed across nodes.
TURING_MESH_SIGNING_SEED=
# Trusted keys: JSON object mapping node_id -> Ed25519 PUBLIC key hex for
# every trusted mesh node, INCLUDING this node itself. A presence message is
# accepted only when its signature verifies under the key bound to the
# claimed sender_id. Keep commented (not empty) when unused — the value must
# be valid JSON when set.
# TURING_MESH_TRUSTED_KEYS={"<node-id-1>":"<pubkey-hex>","<node-id-2>":"<pubkey-hex>"}
TURING_SANDBOX_ENABLED=true
TURING_SANDBOX_TIMEOUT=30
TURING_ALLOWED_WRITE_PATHS=["/tmp","/home/turing/data"]
# Plugin allow-list (fail-closed). Plugins run arbitrary code at startup, so
# none load unless you opt in: a JSON list of plugin names, or ["*"] for all.
# TURING_ALLOWED_PLUGINS=["example_plugin"]
# Host allowlist for the worker-local web_fetch grounding tool (ADR 0009 §2).
# Each entry also admits its subdomains. The default (see
# turing/worker/tools/web_fetch.py DEFAULT_ALLOWED_HOSTS) covers research-paper
# sources: arxiv.org, scholar.google.com (Google Scholar), semanticscholar.org,
# openreview.net, aclanthology.org, paperswithcode.com, openalex.org, dblp.org,
# wikipedia.org, huggingface.co. Consumed by the worker grounding assembly
# when it lands (Phase 0 ships the contract only). Override with a JSON list:
# TURING_WEB_FETCH_ALLOWED_HOSTS=["arxiv.org","scholar.google.com"]
TURING_LEARNING_AUTO_EXTRACT=true
TURING_LEARNING_EXTRACT_INTERVAL=5
TURING_ENV=development
TURING_LOG_LEVEL=INFO

# ── Operator UI gateway (pi-alpha only) ───────────────────────────────
# TURING_GATEWAY_ENABLED defaults to false; flip to true ONLY on pi-alpha.
TURING_GATEWAY_ENABLED=false
# A long random string. The launcher and the SPA both need this — the
# gateway refuses to start when empty.
TURING_GATEWAY_TOKEN=
# Bind to a Tailscale-only interface in production; loopback by default so
# the operator must opt into external exposure explicitly.
TURING_GATEWAY_BIND=127.0.0.1
TURING_GATEWAY_PORT=8765

# ── Telemetry (gateway ring buffer) ──────────────────────────────────
TURING_TELEMETRY_PROMPT_SAMPLE_MAX_BYTES=2048
TURING_TELEMETRY_RETENTION_HOURS=24
TURING_TELEMETRY_MAX_BYTES=524288000

# ── Cloud LLM budget ─────────────────────────────────────────────────
# Hard daily cap in cents. Calls that would exceed the cap are refused
# pre-flight and the router falls back to the local model.
TURING_BUDGET_DAILY_CAP_CENTS=1000
