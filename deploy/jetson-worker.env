# Worker env for the Jetson Orin Nano Super research workers (ADR 0009, #259).
# Identical on all four nodes — the replicated ai-ml-generalist adapter requires
# a matching base. Place at /etc/turing/worker.env (or merge into your env).

# Pinned base model + quantization (3-8B @ Q4 envelope for 8 GB unified memory).
TURING_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
TURING_OLLAMA_HOST=http://localhost:11434

# Workers run quantized local inference only — never cloud, never Discord.
TURING_LLM_ROUTING_MODE=local

# Workers do not run the gateway/webui (that's the coordinator's job).
TURING_GATEWAY_ENABLED=false

# Reach the coordinator's NATS over the LAN (set to the Surface's LAN IP).
# TURING_NATS_URL=nats://<surface-lan-ip>:4222
