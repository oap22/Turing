{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "turing",
  "version": "0.1.0",
  "identifier": "dev.owen.turing",
  "build": {
    "beforeDevCommand": "npm --prefix ../webui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../webui run build",
    "frontendDist": "../../webui/dist"
  },
  "app": {
    "windows": [{ "title": "turing", "width": 1512, "height": 945 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "keyboard-first tiling operator surface for Turing",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
