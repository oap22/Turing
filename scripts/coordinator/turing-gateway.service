# turing-gateway.service — webui static + WebSocket + chat/queue API (ADR-0010 §6).
#
# Part of the three-unit coordinator process layout. The dedicated standalone
# gateway entrypoint now EXISTS (`python -m turing.gateway`), but by default the
# gateway still runs IN-PROCESS inside turing-coordinator.service
# (TURING_GATEWAY_ENABLED=true in .env.coordinator), bound to gateway_port.
#
# Moving the gateway to its own unit is therefore OPT-IN, to avoid a port
# double-bind that would break the coordinator. Flip BOTH of these in
# .env.coordinator to move it:
#
#   TURING_GATEWAY_STANDALONE=1      # this unit execs `python -m turing.gateway`
#   TURING_GATEWAY_ENABLED=false     # coordinator releases gateway_port
#
# To honour ADR-0010 §6 — three units, each Restart=always, installed and
# enabled now — this unit is installed/enabled/started by Phase 7 as a guarded
# wrapper. It execs the dedicated entrypoint only when the opt-in flag is set
# truthy AND the module is importable; otherwise it holds as a clean
# long-running no-op (logging once why) so the unit is genuinely active without
# crash-looping or double-binding the coordinator's in-process gateway. It does
# NOT fire the cold-start ntfy push (only the coordinator unit does).

[Unit]
Description=Turing gateway (webui static + WebSocket + chat/queue API)
After=network-online.target turing-coordinator.service
Wants=network-online.target

[Service]
Type=simple
User=turing
WorkingDirectory=/home/turing/turing
# Run the dedicated gateway entrypoint ONLY when the operator has opted in via
# TURING_GATEWAY_STANDALONE (truthy) AND the module is present; otherwise hold as
# a clean no-op so Restart=always doesn't crash-loop and — critically — we never
# double-bind gateway_port while the coordinator's in-process gateway still owns
# it. The opt-in flag is checked first (cheap), then a plain file-existence probe
# on the module's __main__.py (no heavyweight import). Both branches exec, so
# this stays PID 1 of the unit under Type=simple.
ExecStart=/bin/sh -c 'case "${TURING_GATEWAY_STANDALONE:-}" in 1|true|TRUE|yes|YES|on|ON) if /home/turing/venv/bin/python -c "import turing.gateway,os,sys; sys.exit(0 if os.path.exists(os.path.join(os.path.dirname(turing.gateway.__file__),\"__main__.py\")) else 1)" 2>/dev/null; then echo "turing-gateway: TURING_GATEWAY_STANDALONE set; starting dedicated gateway. Ensure TURING_GATEWAY_ENABLED=false on the coordinator to avoid a port double-bind."; exec /home/turing/venv/bin/python -m turing.gateway; else echo "turing-gateway: TURING_GATEWAY_STANDALONE set but entrypoint missing; holding."; exec sleep infinity; fi ;; *) echo "turing-gateway: standalone gateway opt-out (TURING_GATEWAY_STANDALONE unset); gateway runs in-process under turing-coordinator. Set TURING_GATEWAY_STANDALONE=1 and TURING_GATEWAY_ENABLED=false to move it here. Holding."; exec sleep infinity ;; esac'
Restart=always
RestartSec=10
EnvironmentFile=/home/turing/turing/.env.coordinator

[Install]
WantedBy=multi-user.target
